/// SYNTHETIC DATA · for training only · no real customer data
table dim_account

	measure 'Total Balance' = SUM(dim_account[balance])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00

	column account_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: account_id

	column customer_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_id

	column account_type
		dataType: string
		summarizeBy: none
		sourceColumn: account_type

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column opened_at
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: opened_at

	column balance
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		summarizeBy: none
		sourceColumn: balance

	column currency
		dataType: string
		summarizeBy: none
		sourceColumn: currency

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	partition dim_account = entity
		mode: directLake
		source
			entityName: dim_account
			schemaName: gold
			expressionSource: DatabaseQuery
