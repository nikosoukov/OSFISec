/// SYNTHETIC DATA · for training only · no real customer data
table fact_transaction_monthly

	measure 'Transaction Count' = SUM(fact_transaction_monthly[txn_count])
		formatString: #,0

	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: month_start

	column account_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: account_id

	column customer_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_id

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	column txn_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: txn_count

	column debit_total
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		summarizeBy: none
		sourceColumn: debit_total

	column credit_total
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		summarizeBy: none
		sourceColumn: credit_total

	column net_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		summarizeBy: none
		sourceColumn: net_amount

	partition fact_transaction_monthly = entity
		mode: directLake
		source
			entityName: fact_transaction_monthly
			schemaName: gold
			expressionSource: DatabaseQuery
