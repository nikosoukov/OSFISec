/// SYNTHETIC DATA · for training only · no real customer data
table fact_loan

	measure 'Loan Amount' = SUM(fact_loan[amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00

	measure 'Loan Count' = COUNTROWS(fact_loan)
		formatString: #,0

	column application_id
		dataType: string
		summarizeBy: none
		sourceColumn: application_id

	column customer_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_id

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	column product
		dataType: string
		summarizeBy: none
		sourceColumn: product

	column amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		summarizeBy: none
		sourceColumn: amount

	column rate
		dataType: decimal
		formatString: 0.000
		summarizeBy: none
		sourceColumn: rate

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column submitted_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: submitted_at

	column submitted_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: submitted_date

	partition fact_loan = entity
		mode: directLake
		source
			entityName: fact_loan
			schemaName: gold
			expressionSource: DatabaseQuery
