/// SYNTHETIC DATA · for training only · no real customer data
table dim_customer

	measure Customers = DISTINCTCOUNT(dim_customer[customer_id])
		formatString: #,0

	column customer_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_id

	column first_name
		dataType: string
		summarizeBy: none
		sourceColumn: first_name

	column last_name
		dataType: string
		summarizeBy: none
		sourceColumn: last_name

	column email
		dataType: string
		summarizeBy: none
		sourceColumn: email

	column sin
		dataType: string
		summarizeBy: none
		sourceColumn: sin

	column date_of_birth
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date_of_birth

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	column segment
		dataType: string
		summarizeBy: none
		sourceColumn: segment

	column created_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: created_at

	partition dim_customer = entity
		mode: directLake
		source
			entityName: dim_customer
			schemaName: gold
			expressionSource: DatabaseQuery
